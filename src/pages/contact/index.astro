---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import { href, waLink } from '../../lib/url';
import Ph from '../../components/Ph.astro';
import Annotation from '../../components/Annotation.astro';
import NapBlock from '../../components/NapBlock.astro';
---
<BaseLayout
  title="Contact DK Polymer, Bawana Industrial Area, Delhi"
  description="Contact DK Polymer in Sector 5, Bawana Industrial Area, Delhi: phone, email, WhatsApp, opening hours and directions."
  path="/contact/"
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
  includeLocalBusiness
>
  <div class="wrap">
    <h1>Contact DK Polymer</h1>
    <p class="lead">DK Polymer is in Sector 5, Bawana Industrial Area, Delhi. Call, email or message us on WhatsApp.</p>

    <div class="grid grid-2">
      <section aria-labelledby="details-h">
        <h2 id="details-h">Address and phone</h2>
        <NapBlock />
        <h3>Opening hours</h3>
        <p><Ph text={site.openingHours.display} /></p>
        <h3>WhatsApp</h3>
        <div class="btn-row">
          <a class="btn btn-primary" href={waLink(site.whatsapp.number, site.whatsapp.buyerMessage)} data-event="whatsapp_click" data-event-location="contact_buyer" rel="noopener">WhatsApp: I want to buy</a>
          <a class="btn btn-secondary" href={waLink(site.whatsapp.number, site.whatsapp.supplierMessage)} data-event="whatsapp_scrap_click" data-event-location="contact_supplier" rel="noopener">WhatsApp: I have scrap</a>
        </div>
        <p class="small">Number: <Ph text={site.whatsapp.display} /></p>
      </section>

      <section aria-labelledby="map-h">
        <Annotation tag="GEO" text="map placeholder; embed only after consent decision" />
        <h2 id="map-h">Map and directions</h2>
        <div class="img-box map-box" role="img" aria-label="Map placeholder showing DK Polymer in Sector 5, Bawana Industrial Area, Delhi">
          <span aria-hidden="true">MAP PLACEHOLDER</span>
        </div>
        <div class="btn-row">
          <a class="btn btn-secondary" href={site.directionsUrl} data-event="directions_click" rel="noopener">Get directions</a>
          <a class="btn btn-secondary" href={site.googleBusinessProfileUrl} data-event="gbp_click" rel="noopener">View on Google</a>
        </div>
        <p class="small">Google Business Profile: <Ph text={site.googleBusinessProfileNote} /></p>
      </section>
    </div>

    <section class="section" aria-labelledby="next-h">
      <h2 id="next-h">What do you need?</h2>
      <ul>
        <li>Buying granules: <a href={href('/request-a-quote/')} data-event="cta_quote_click" data-event-location="contact">Request a quote</a></li>
        <li>Selling PBT scrap: <a href={href('/sell-your-scrap/')}>How scrap collection works</a></li>
        <li>Quick answers: <a href={href('/faq/')}>FAQ</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
